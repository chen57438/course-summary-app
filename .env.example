# Choose one: gemini, openai, or deepseek.
AI_PROVIDER=gemini

# Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
